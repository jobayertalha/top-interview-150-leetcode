"""
Problem:
Given the root of a binary tree, imagine you are standing
on the right side of the tree.

Return the values of the nodes that are visible from the
right side, ordered from top to bottom.

Idea:
Use Breadth-First Search (BFS) level by level.

For each level:
    The LAST node we process is the rightmost node.

So we add only the last node of every level to the result.

Approach:
1. If the tree is empty, return [].
2. Put the root into a queue.
3. Process the tree level by level.
4. Find the number of nodes in the current level.
5. Process exactly those nodes.
6. When processing the last node of the level,
   add its value to the result.
7. Add the children to the queue.
8. Repeat until the queue is empty.

Example:

        1
       / \
      2   3
       \   \
        5   4

Levels:
Level 1 → [1]
Level 2 → [2, 3]
Level 3 → [5, 4]

Right-side view:
[1, 3, 4]

Time Complexity: O(n)
    Every node is visited once.

Space Complexity: O(n)
    The queue can contain nodes from a whole level.
"""


from collections import deque


class Solution(object):
    def rightSideView(self, root):

        # If the tree is empty,
        # there is nothing visible.
        if not root:
            return []

        # Create a queue for BFS.
        #
        # Start with the root node.
        queue = deque([root])

        # Store the nodes visible from the right side.
        result = []

        # Continue while there are nodes to process.
        while queue:

            # Number of nodes currently in this level.
            #
            # This tells us exactly where this level ends.
            level_size = len(queue)

            # Process every node in the current level.
            for i in range(level_size):

                # Remove the first node from the queue.
                node = queue.popleft()

                # If this is the LAST node of the current level,
                # it is the rightmost node.
                #
                # Therefore, it is visible from the right side.
                if i == level_size - 1:
                    result.append(node.val)

                # Add the left child for the next level.
                if node.left:
                    queue.append(node.left)

                # Add the right child for the next level.
                if node.right:
                    queue.append(node.right)

        # Return the right-side view.
        return result

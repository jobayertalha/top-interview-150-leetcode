"""
Problem:
--------
Check whether a string of words follows a given pattern.

Each pattern character must map to exactly one word,
and each word must map to exactly one pattern character.

Example:
    pattern = "abba"
    s = "dog cat cat dog"

    Output: True

    a → dog
    b → cat

Key Idea:
---------
Use two dictionaries to maintain a one-to-one mapping:

    pattern_to_word: character → word
    word_to_pattern: word → character

Why two dictionaries?
---------------------
The first prevents one character from mapping to different words.
The second prevents different characters from mapping to the same word.

Steps:
------
1. Split s into words.
2. Check if pattern and words have equal lengths.
3. Check both mappings for every character-word pair.
4. Return False if any mapping conflicts; otherwise True.

Important:
----------
zip(pattern, words) processes corresponding characters and words.

Complexity:
-----------
Time:  O(n + m), where n = pattern length and m = string length.
Space: O(n + m) for the words and dictionaries.

Memory Trick:
-------------
"CHAR → WORD and WORD → CHAR"
Both directions must match.
"""

class Solution(object):
    def wordPattern(self, pattern, s):

        # Split the string into words
        words = s.split(" ")

        # Pattern and words must have equal lengths
        if len(pattern) != len(words):
            return False

        # Map each character to its word
        pattern_to_word = {}

        # Map each word to its character
        word_to_pattern = {}

        # Check every character-word pair
        for ch, word in zip(pattern, words):

            # Character already exists → check its word
            if ch in pattern_to_word:
                if pattern_to_word[ch] != word:
                    return False

            # First occurrence → create the mapping
            else:
                pattern_to_word[ch] = word

            # Word already exists → check its character
            if word in word_to_pattern:
                if word_to_pattern[word] != ch:
                    return False

            # First occurrence → create the mapping
            else:
                word_to_pattern[word] = ch

        # Every mapping is consistent
        return True

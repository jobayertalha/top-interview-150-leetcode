"""
Problem:
--------
Sort a linked list in ascending order.

Example:
    Input:  4 → 2 → 1 → 3
    Output: 1 → 2 → 3 → 4

Key Idea:
---------
Use Merge Sort:

    1. Find the middle
    2. Split into two halves
    3. Recursively sort both halves
    4. Merge the sorted halves

Why Merge Sort?
---------------
Merge Sort works well with linked lists because we can
reconnect nodes using next pointers without shifting elements.

Important:
----------
slow → moves 1 step
fast → moves 2 steps

fast starts at head.next so slow stops at the end of
the first half.

Example:

    1 → 2 → 3 → 4

Split into:

    1 → 2
    3 → 4

Merge:
    1 → 2 + 3 → 4
        ↓
    1 → 2 → 3 → 4

Base Case:
----------
A list with 0 or 1 node is already sorted.

    if not head or not head.next:
        return head

Merge:
------
Compare the first nodes of both sorted lists.
Take the smaller one and move forward.

Time Complexity:
----------------
O(n log n)

Space Complexity:
-----------------
O(log n) recursion stack.

Memory Trick:
-------------
    SPLIT → SORT → MERGE

For merging:
    COMPARE → TAKE SMALLER → MOVE
"""

class Solution:
    def sortList(self, head):

        # Empty list or one node → already sorted
        if not head or not head.next:
            return head

        # Find the middle using slow & fast pointers
        slow = head
        fast = head.next

        # slow moves 1 step, fast moves 2 steps
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next

        # Second half starts after slow
        second = slow.next

        # Cut the list into two separate halves
        slow.next = None

        # Recursively sort the first half
        left = self.sortList(head)

        # Recursively sort the second half
        right = self.sortList(second)

        # Merge the two sorted halves
        return self.merge(left, right)

    def merge(self, left, right):

        # Dummy node makes merging easier
        dummy = ListNode(0)

        # current points to the last node of merged list
        current = dummy

        # Compare nodes while both lists have elements
        while left and right:

            # Take the smaller value
            if left.val < right.val:
                current.next = left
                left = left.next
            else:
                current.next = right
                right = right.next

            # Move current to the newly added node
            current = current.next

        # Attach the remaining nodes
        if left:
            current.next = left
        else:
            current.next = right

        # dummy is not part of answer
        return dummy.next

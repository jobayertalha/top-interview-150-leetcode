"""
Problem:
Design a data structure that follows the Least Recently Used (LRU)
cache policy.

The cache supports:

    get(key)
        → Return the value if the key exists.
        → Otherwise return -1.

    put(key, value)
        → Insert a new key-value pair or update an existing one.
        → If the cache exceeds its capacity, remove the
          least recently used item.

Important:
Both get() and put() must work in O(1) average time.

Idea:
Use TWO data structures together:

1. Hash Map
   key → Node

   This lets us find a key in O(1).

2. Doubly Linked List

   This keeps track of usage order.

   Head → LRU ... MRU → Tail

   - Front = Least Recently Used
   - End = Most Recently Used

Whenever a key is used:
    Remove it from its current position
    Add it to the end

When the cache is full:
    Remove the first real node (LRU).

Why doubly linked list?
Because we need to remove a node from the middle in O(1).
With both prev and next pointers, we can do that directly.

Example:

capacity = 2

put(1, 10)
put(2, 20)

List:
LRU → 1 → 2 ← MRU

get(1)

1 was just used, so:
LRU → 2 → 1 ← MRU

put(3, 30)

Cache is full, so remove 2:
LRU → 1 → 3 ← MRU

Time Complexity:
    get() → O(1) average
    put() → O(1) average

Space Complexity:
    O(capacity)
"""


class Node:

    # Create a node containing a key and value.
    def __init__(self, key, value):

        # Store the key.
        self.key = key

        # Store the value.
        self.value = value

        # Pointer to the previous node.
        self.prev = None

        # Pointer to the next node.
        self.next = None


class LRUCache:

    # Initialize the cache.
    def __init__(self, capacity):

        # Store the maximum number of items
        # the cache can contain.
        self.capacity = capacity

        # Hash map:
        #
        # key → Node
        #
        # This allows us to find a node in O(1).
        self.cache = {}

        # Dummy head node.
        #
        # The first real node after head
        # will always be the LRU node.
        self.head = Node(0, 0)

        # Dummy tail node.
        #
        # The last real node before tail
        # will always be the MRU node.
        self.tail = Node(0, 0)

        # Initially, there are no real nodes.
        #
        # head ↔ tail
        self.head.next = self.tail
        self.tail.prev = self.head


    # Remove a node from the doubly linked list.
    def remove(self, node):

        # Get the node immediately before
        # the node we want to remove.
        prev_node = node.prev

        # Get the node immediately after
        # the node we want to remove.
        next_node = node.next

        # Connect the previous node directly
        # to the next node.
        prev_node.next = next_node

        # Connect the next node back to
        # the previous node.
        next_node.prev = prev_node


    # Add a node immediately before the dummy tail.
    #
    # Therefore, this node becomes the MRU node.
    def add_to_end(self, node):

        # Get the current last real node.
        prev_node = self.tail.prev

        # Connect the previous last node
        # to the new node.
        prev_node.next = node

        # Connect the new node back
        # to the previous node.
        node.prev = prev_node

        # Connect the new node to the dummy tail.
        node.next = self.tail

        # Connect the tail back to the new node.
        self.tail.prev = node


    # Return the value associated with a key.
    def get(self, key):

        # If the key does not exist...
        if key not in self.cache:

            # Return -1.
            return -1

        # Get the corresponding node
        # from the hash map.
        node = self.cache[key]

        # Remove the node from its current position.
        self.remove(node)

        # Add it to the end because accessing it
        # makes it the Most Recently Used node.
        self.add_to_end(node)

        # Return the stored value.
        return node.value


    # Insert or update a key-value pair.
    def put(self, key, value):

        # If the key already exists...
        if key in self.cache:

            # Get the existing node.
            node = self.cache[key]

            # Update its value.
            node.value = value

            # Remove it from its current position.
            self.remove(node)

            # Move it to the end because
            # it has just been used.
            self.add_to_end(node)

        else:

            # Create a new node.
            node = Node(key, value)

            # Store the node in the hash map.
            #
            # key → node
            self.cache[key] = node

            # Add the new node to the end.
            # It is now the most recently used.
            self.add_to_end(node)

            # If the cache exceeds its capacity...
            if len(self.cache) > self.capacity:

                # The first real node is the
                # Least Recently Used node.
                lru = self.head.next

                # Remove the LRU node from the linked list.
                self.remove(lru)

                # Remove the LRU key from the hash map.
                del self.cache[lru.key]

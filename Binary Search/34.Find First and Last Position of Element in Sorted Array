"""
Problem:
--------
Given a sorted array, find the first and last position of target.

If target does not exist, return [-1, -1].

Example:
    nums = [5, 7, 7, 8, 8, 10]
    target = 8

    Output:
        [3, 4]

Key Idea:
---------
Use Binary Search TWO times:

    1. find_first() → find the leftmost target
    2. find_last()  → find the rightmost target

Finding FIRST:
    target found
        → save mid
        → continue LEFT

    right = mid - 1

Finding LAST:
    target found
        → save mid
        → continue RIGHT

    left = mid + 1

Important:
----------
We cannot stop when we first find target,
because there may be more target values on either side.

So:

    First → keep searching LEFT
    Last  → keep searching RIGHT

If target is never found:
    result remains -1.

Complexity:
-----------
Each binary search: O(log n)

Total Time:  O(log n)
Space:       O(1)

Memory Trick:
-------------
    FIRST → Found → Save → Go LEFT
    LAST  → Found → Save → Go RIGHT
"""


class Solution:
    def searchRange(self, nums, target):

        # Find the FIRST occurrence
        def find_first():

            # Search range
            left = 0
            right = len(nums) - 1

            # Store the best answer found so far
            result = -1

            # Binary search
            while left <= right:

                # Find middle index
                mid = (left + right) // 2

                # Target found
                if nums[mid] == target:

                    # Save this index
                    result = mid

                    # Look further LEFT
                    right = mid - 1

                # Middle value is smaller
                elif nums[mid] < target:

                    # Target is on the right
                    left = mid + 1

                # Middle value is larger
                else:

                    # Target is on the left
                    right = mid - 1

            # Return first occurrence
            return result

        # Find the LAST occurrence
        def find_last():

            # Search range
            left = 0
            right = len(nums) - 1

            # Store the best answer found so far
            result = -1

            # Binary search
            while left <= right:

                # Find middle index
                mid = (left + right) // 2

                # Target found
                if nums[mid] == target:

                    # Save this index
                    result = mid

                    # Look further RIGHT
                    left = mid + 1

                # Middle value is smaller
                elif nums[mid] < target:

                    # Target is on the right
                    left = mid + 1

                # Middle value is larger
                else:

                    # Target is on the left
                    right = mid - 1

            # Return last occurrence
            return result

        # Find both boundaries
        first = find_first()
        last = find_last()

        # Return [first, last]
        return [first, last]

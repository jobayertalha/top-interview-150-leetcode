"""
Problem:
--------
Given a matrix where:
1. Each row is sorted.
2. The first value of each row is greater than the last value
   of the previous row.

Return True if target exists, otherwise False.

Example:
    matrix = [
        [1, 3, 5, 7],
        [10, 11, 16, 20],
        [23, 30, 34, 60]
    ]

    target = 3
    Output = True

Key Idea:
---------
Treat the entire matrix as one sorted 1D array.

Example:

    Matrix:
    [1,  3,  5,  7]
    [10, 11, 16, 20]
    [23, 30, 34, 60]

    Imagine:
    [1, 3, 5, 7, 10, 11, 16, 20, 23, 30, 34, 60]

Instead of creating this new array, use an index `mid`.

Convert 1D index → matrix position:

    row = mid // n
    col = mid % n

Important:
---------
`n` = number of columns.

For example, if n = 4:

    mid = 6

    row = 6 // 4 = 1
    col = 6 % 4  = 2

So:
    matrix[1][2]

Base case:
----------
No special recursion base case.
The binary search stops when:

    left > right

Complexity:
-----------
Time:  O(log(m × n))
Space: O(1)

Memory Trick:
-------------
Think of the matrix as a 1D sorted array.

    1D index → row = mid // n
             → col = mid % n

Then use normal Binary Search.
"""


class Solution:
    def searchMatrix(self, matrix, target):

        # Number of rows
        m = len(matrix)

        # Number of columns
        n = len(matrix[0])

        # Treat the whole matrix as a sorted 1D array
        left = 0
        right = m * n - 1

        # Standard binary search
        while left <= right:

            # Find middle 1D index
            mid = (left + right) // 2

            # Convert 1D index → row
            row = mid // n

            # Convert 1D index → column
            col = mid % n

            # Get value from the matrix
            value = matrix[row][col]

            # Target found
            if value == target:
                return True

            # Target is larger → search right half
            elif value < target:
                left = mid + 1

            # Target is smaller → search left half
            else:
                right = mid - 1

        # Target does not exist
        return False

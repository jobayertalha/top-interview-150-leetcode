"""
Problem:
--------
Given two sorted arrays nums1 and nums2, find the k pairs
with the smallest sums.

A pair is:

    [nums1[i], nums2[j]]

Example:
    nums1 = [1, 7, 11]
    nums2 = [2, 4, 6]
    k = 3

    Smallest pairs:
        [1,2] → sum 3
        [1,4] → sum 5
        [1,6] → sum 7

Key Idea:
---------
Think of each nums1 element as the start of a sorted row:

    nums1[0] + nums2[0]
    nums1[0] + nums2[1]
    nums1[0] + nums2[2]

    nums1[1] + nums2[0]
    nums1[1] + nums2[1]
    nums1[1] + nums2[2]

Each row is sorted because nums2 is sorted.

Use a MIN HEAP to always get the smallest available pair.

Initially:
    Put the first pair from each row into the heap.

Then:
    1. Pop the smallest pair.
    2. Add it to result.
    3. Move one step right in the SAME row.
    4. Push that new pair into the heap.

Why only min(k, len(nums1)) rows?
---------------------------------
We only need k pairs.

So there is no need to start more than k rows.

Heap entry:
------------
    (sum, i, j)

where:
    sum → pair's total
    i   → index in nums1
    j   → index in nums2

Important:
----------
After popping `(i, j)`, only:

    (i, j + 1)

needs to be added.

We do NOT need to add `(i + 1, j)` because that row's
first element was already added to the heap initially.

Complexity:
-----------
Let k be the number of pairs returned.

Time:  O(k log k)
Space: O(k)

Memory Trick:
-------------
    FIRST of each row → HEAP
            ↓
        POP smallest
            ↓
        ADD answer
            ↓
        PUSH next in same row
            ↓
        Repeat k times
"""


import heapq


class Solution:
    def kSmallestPairs(self, nums1, nums2, k):

        # Min heap stores:
        # (sum, index in nums1, index in nums2)
        heap = []

        # Start the first pair of each possible row
        for i in range(min(k, len(nums1))):

            # First pair in this row uses nums2[0]
            heapq.heappush(
                heap,
                (nums1[i] + nums2[0], i, 0)
            )

        # Store the k smallest pairs
        result = []

        # Continue while pairs are available
        # and we still need more answers
        while heap and len(result) < k:

            # Get the pair with the smallest sum
            total, i, j = heapq.heappop(heap)

            # Add the actual pair to the result
            result.append([nums1[i], nums2[j]])

            # Move one step right in the same row
            next_j = j + 1

            # Make sure nums2 still has another element
            if next_j < len(nums2):

                # Add the next pair from the same row
                heapq.heappush(
                    heap,
                    (
                        nums1[i] + nums2[next_j],
                        i,
                        next_j
                    )
                )

        # Return the k smallest pairs
        return result

"""
Problem:
--------
Given three strings s1, s2, and s3, determine whether s3 can be
formed by interleaving s1 and s2 while keeping the original
character order of both strings.

Example:
    s1 = "aabcc"
    s2 = "dbbca"
    s3 = "aadbbcbcac"

    Output: True

Key Idea:
---------
Use Dynamic Programming.

dp[i][j] = True means:

    We can form the first (i + j) characters of s3
    using the first i characters of s1
    and the first j characters of s2.

At each position, we have two choices:

    1. Take the next character from s1
    2. Take the next character from s2

If either choice works, dp[i][j] becomes True.

Important:
----------
The character of s3 we need to match is:

    k = i + j - 1

Because s3 uses exactly i + j characters at dp[i][j].

Base Case:
----------
dp[0][0] = True

An empty s1 and empty s2 can create an empty s3.

Complexity:
-----------
Time:  O(len(s1) × len(s2))
Space: O(len(s1) × len(s2))

Memory Trick:
-------------
"Take from S1 OR Take from S2."

dp[i][j] =
    (TOP and S1 matches) OR
    (LEFT and S2 matches)
"""

class Solution:
    def isInterleave(self, s1, s2, s3):

        # Total characters must be equal
        if len(s1) + len(s2) != len(s3):
            return False

        # dp[i][j] = can we form first i+j characters of s3?
        # using first i chars of s1 and first j chars of s2
        dp = [[False] * (len(s2) + 1)
              for _ in range(len(s1) + 1)]

        # Empty + Empty = Empty
        dp[0][0] = True

        # Try every number of characters taken from s1
        for i in range(len(s1) + 1):

            # Try every number of characters taken from s2
            for j in range(len(s2) + 1):

                # Starting state is already True
                if i == 0 and j == 0:
                    continue

                # Current character in s3 that we need to match
                k = i + j - 1

                # Take the current character from s1
                # TOP = dp[i-1][j]
                if i > 0 and dp[i - 1][j] and s1[i - 1] == s3[k]:
                    dp[i][j] = True

                # Take the current character from s2
                # LEFT = dp[i][j-1]
                if j > 0 and dp[i][j - 1] and s2[j - 1] == s3[k]:
                    dp[i][j] = True

        # Final state = can we form the entire s3?
        return dp[len(s1)][len(s2)]

"""
Problem:
--------
Convert word1 into word2 using the minimum number of operations.

Allowed operations:
    1. Insert a character
    2. Delete a character
    3. Replace a character

Example:
    word1 = "horse"
    word2 = "ros"

    Output: 3

    horse → rorse → rose → ros

Key Idea:
---------
Use Dynamic Programming.

dp[i][j] = minimum operations needed to convert:
    first i characters of word1
    into first j characters of word2.

For each pair of characters:

    If they are the same:
        No operation is needed.

    If they are different:
        Try all 3 operations:
            - Delete
            - Insert
            - Replace

        Take the minimum + 1.

Base Cases:
-----------
dp[i][0] = i
    Convert word1[:i] to empty → delete i characters.

dp[0][j] = j
    Convert empty to word2[:j] → insert j characters.

Important Transitions:
----------------------
Delete  → dp[i-1][j]
Insert  → dp[i][j-1]
Replace → dp[i-1][j-1]

Complexity:
-----------
Time:  O(m × n)
Space: O(m × n)

Memory Trick:
-------------
"Same → Diagonal"
"Different → Delete, Insert, Replace → MIN + 1"
"""

class Solution:
    def minDistance(self, word1, word2):

        # Length of both words
        m = len(word1)
        n = len(word2)

        # dp[i][j] = minimum operations to convert
        # word1[:i] into word2[:j]
        dp = [[0] * (n + 1) for _ in range(m + 1)]

        # word2 is empty → delete all characters from word1
        for i in range(m + 1):
            dp[i][0] = i

        # word1 is empty → insert all characters of word2
        for j in range(n + 1):
            dp[0][j] = j

        # Compare every prefix of word1 and word2
        for i in range(1, m + 1):
            for j in range(1, n + 1):

                # Characters are the same → no operation needed
                if word1[i - 1] == word2[j - 1]:
                    dp[i][j] = dp[i - 1][j - 1]

                # Characters are different
                else:
                    # Delete word1[i-1]
                    delete = dp[i - 1][j]

                    # Insert word2[j-1]
                    insert = dp[i][j - 1]

                    # Replace word1[i-1]
                    replace = dp[i - 1][j - 1]

                    # Choose the cheapest operation
                    dp[i][j] = 1 + min(
                        delete,
                        insert,
                        replace
                    )

        # Final cell = minimum operations for whole words
        return dp[m][n]

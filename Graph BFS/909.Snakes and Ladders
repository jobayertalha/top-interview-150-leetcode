from collections import deque

class Solution(object):
    def snakesAndLadders(self, board):

        # Get the size of the board
        n = len(board)

        # Total number of squares
        target = n * n

        # Queue stores:
        # (current square, number of dice rolls)
        queue = deque([(1, 0)])

        # Keep track of squares we already visited
        visited = set([1])

        # BFS
        while queue:

            # Take the first square from the queue
            current, moves = queue.popleft()

            # Try all possible dice rolls from 1 to 6
            for dice in range(1, 7):

                # Calculate the square we land on
                next_square = current + dice

                # We cannot go beyond the final square
                if next_square > target:
                    break

                # Convert square number to board row
                row = n - 1 - (next_square - 1) // n

                # Convert square number to board column
                col = (next_square - 1) % n

                # Reverse the column on every other row
                if (n - 1 - row) % 2 == 1:
                    col = n - 1 - col

                # Check whether there is a snake or ladder
                if board[row][col] != -1:

                    # Move to the snake/ladder destination
                    next_square = board[row][col]

                # If we reached the final square
                if next_square == target:
                    return moves + 1

                # If we have not visited this square before
                if next_square not in visited:

                    # Mark it as visited
                    visited.add(next_square)

                    # Add it to the queue
                    queue.append((next_square, moves + 1))

        # If we cannot reach the final square
        return -1
